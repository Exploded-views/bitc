{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bitc status --json",
  "type": "object",
  "required": ["version", "time", "pools", "groups", "memory"],
  "properties": {
    "version": {"type": "string"},
    "time": {"type": "string"},
    "pools": {"type": "array", "items": {"type": "object", "required": ["name", "slots", "holders", "waiters"],
      "properties": {
        "name": {"type": "string"}, "slots": {"type": "integer"}, "last_starved": {"type": "string"},
        "wait": {"type": "string", "description": "the pool's configured wait, in the duration form of the spec (5.2), such as 3h or 1h30m"},
        "oldest_wait_s": {"type": "integer", "description": "whole seconds the longest-waiting waiter has waited, to the report's time; present only when the pool has waiters"},
        "holders": {"type": "array", "items": {"type": "object", "required": ["job", "slot", "pid", "cwd", "argv", "provider", "nested", "since"],
          "properties": {"job": {"type": "string"}, "slot": {"type": "integer"}, "pid": {"type": "integer"}, "cwd": {"type": "string"},
            "argv": {"type": "array", "items": {"type": "string"}}, "provider": {"type": "string"}, "nested": {"type": "boolean"}, "since": {"type": "string"},
            "units": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "units held per group (absent when the run holds no group units itself (the pool lists no group, or a nested hold inherits them all))"},
            "legacy": {"type": "boolean", "description": "true for a slot held by a legacy shell-pool caller under [compat]; such a holder has job \"legacy\", empty since, cwd and argv, and pid 0 when the lock file holds no pid"},
            "unknown": {"type": "boolean", "description": "true when the slot is in use as far as its ticket or lock file shows but this host cannot read lock holders (Linux without a readable /proc/locks); whether the holder is alive is not known, no pid is claimed for a legacy holder, and the slot is neither held nor free. Absent otherwise"}}}},
        "waiters": {"type": "array", "items": {"type": "object", "required": ["job", "class", "pid", "since"],
          "properties": {"job": {"type": "string"}, "class": {"enum": ["high", "normal"]}, "pid": {"type": "integer"}, "since": {"type": "string"}, "group_wait": {"type": "string"},
            "waited_s": {"type": "integer", "description": "whole seconds from since to the report's time"},
            "units": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "units asked for per group, with --units applied"},
            "unknown": {"type": "boolean", "description": "true when whether the waiter is alive cannot be read (Linux without a readable /proc/locks); absent otherwise"}}}}
      }}},
    "groups": {"type": "array", "items": {"type": "object", "required": ["name", "units", "held"],
      "properties": {"name": {"type": "string"}, "units": {"type": "integer"}, "held": {"type": "array", "items": {"type": "integer"}},
      "unknown": {"type": "array", "items": {"type": "integer"}, "description": "units whose holder cannot be read (Linux without a readable /proc/locks); absent when empty"}}}},
    "memory": {"type": "object", "required": ["available_mib", "readable", "source", "floor_mib"],
      "properties": {"available_mib": {"type": "integer"}, "readable": {"type": "boolean"}, "source": {"type": "string"}, "floor_mib": {"type": "integer"}}},
    "legacy": {"type": "array", "items": {"type": "string"}},
    "remote": {"type": "object", "additionalProperties": {"type": "object",
      "required": ["own", "foreign", "spend_usd", "ledger_usd", "breaker"],
      "properties": {
        "own": {"type": "array", "items": {"type": "object", "required": ["id", "name", "pool", "expires"],
          "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "pool": {"type": "string"}, "expires": {"type": "string"}}}},
        "foreign": {"type": "array", "items": {"type": "object", "required": ["id", "name", "pool", "expires"],
          "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "pool": {"type": "string"}, "expires": {"type": "string"}}}},
        "spend_usd": {"type": "string"}, "ledger_usd": {"type": "string"}, "est_usd_today": {"type": "string"}, "last_sweep": {"type": "string"}, "foreign_org": {"type": "string"}, "breaker": {"type": "string"}, "error": {"type": "string"},
        "slots": {"type": "object", "required": ["total", "busy", "free", "held"],
          "properties": {"total": {"type": "integer"}, "busy": {"type": "integer"}, "free": {"type": "integer"},
            "held": {"type": "array", "items": {"type": "object", "required": ["slots", "name", "own", "until"],
              "properties": {"slots": {"type": "array", "items": {"type": "integer"}}, "name": {"type": "string"}, "own": {"type": "boolean"}, "until": {"type": "string"}}}}}}}}}
  }
}
